{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DoraBase",
  "version": "../package.json",
  "identifier": "com.dorabase.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm proxy:embarquer && pnpm dev",
    "beforeBuildCommand": "pnpm proxy:embarquer && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "DoraBase",
        "width": 1360,
        "height": 814,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ipc://localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/cloud-sql-proxy"],
    "resources": ["licences/cloud-sql-proxy/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
